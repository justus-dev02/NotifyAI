            "value" : "Remove filler words"
          }
        }
      }
    },
    "Für Aufnahmen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For recordings"
          }
        }
      }
    },
    "Für das Transkript, direkt auf dem Gerät" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For the transcript, right on your device"
          }
        }
      }
    },
    "Für diese Aufnahme gibt es noch kein Transkript." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no transcript for this recording yet."
          }
        }
      }
    },
    "Für diese Notiz wurde noch keine Zusammenfassung erstellt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No summary has been created for this note yet."
          }
        }
      }
    },
    "Für Online-Meetings fragt macOS beim ersten Mitschnitt zusätzlich, ob NotifyAI Systemaudio aufnehmen darf." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For online meetings, macOS also asks the first time whether NotifyAI may record system audio."
          }
        }
      }
    },
    "Ganze Wörter werden ersetzt; die Zeitstempel bleiben erhalten. Bleibt „Ersetzen durch“ leer, wird das Wort entfernt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whole words are replaced; timestamps are kept. If “Replace with” is empty, the word is removed."
          }
        }
      }
    },
    "Geheimnis sichern" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save Secret"
          }
        }
      }
    },
    "Geladen · %@" : {
