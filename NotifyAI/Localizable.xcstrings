      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotifyAI runs quietly in the menu bar, without a Dock icon or app menu. Open the main window with “Open NotifyAI” in the menu bar; quit the app there with ⏻."
