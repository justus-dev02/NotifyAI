{
  "sourceLanguage" : "de",
  "strings" : {
    "„%@“" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”"
          }
        }
      }
    },
    "„%@“ benennen …" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name “%@”…"
          }
        }
      }
    },
    "„%@“ ist nicht geöffnet. Öffne die App vor dem Start oder wähle „Alle Apps“." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is not open. Open the app before starting or choose “All Apps”."
          }
        }
      }
    },
    "„%@“ löschen?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete “%@”?"
          }
        }
      }
    },
    "„%@“ steht schon im eigenen Vokabular." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is already in your custom vocabulary."
          }
        }
      }
    },
    "„%@“ vergessen?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forget “%@”?"
          }
        }
      }
    },
    "„%@“ wird von %lld Notizen entfernt. Die Notizen bleiben erhalten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@“ wird von %2$lld Notizen entfernt. Die Notizen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is removed from %2$lld notes. The notes are kept."
          }
        }
      }
    },
    "„%@“ wird von einer Notiz entfernt. Die Notiz bleibt erhalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is removed from one note. The note is kept."
          }
        }
      }
    },
    "%@ · %@ · %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
