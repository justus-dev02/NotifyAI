        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo (Text Recognition)…"
          }
        }
      }
    },
    "Frag deine Notizen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
