{
  "sourceLanguage" : "de",
  "strings" : {
    "%@ (nicht geöffnet)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (not open)"
          }
        }
      }
    },
    "%@ Bis dahin erstellt NotifyAI eine einfache Zusammenfassung aus den wichtigsten Sätzen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Until then, NotifyAI creates a simple summary from the most important sentences."
          }
        }
      }
    },
    "%@ Die Auswahl gilt für neue Aufnahmen und kann vor jeder Aufnahme geändert werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ The choice applies to new recordings and can be changed before each recording."
          }
        }
      }
    },
    "%@ Ich zeige dann die passenden Stellen statt einer formulierten Antwort." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ I’ll show the matching passages instead of a written answer."
          }
        }
      }
    },
    "%@ wird geladen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
