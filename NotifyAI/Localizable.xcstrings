            "value" : "Remove …"
          }
        }
      }
    },
    "Entfernt „äh“, „ähm“ und ähnliche Laute aus neuen Transkripten. Bestehende Transkripte bereinigst du in der Notiz über „Mehr“." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes “uh”, “um” and similar sounds from new transcripts. To clean up existing transcripts, use “More” in the note."
          }
        }
      }
    },
    "Entscheidungen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decisions"
          }
        }
      }
    },
    "Entsperre die App, um deine Notizen zu sehen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock the app to see your notes."
