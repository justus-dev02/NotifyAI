            "state" : "translated",
            "value" : "Ready"
          }
        }
      }
    },
    "Fertige Notizen automatisch senden" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send finished notes automatically"
          }
        }
      }
    },
    "Fertige Notizen automatisch sichern" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save finished notes automatically"
          }
        }
      }
    },
    "Fertige Notizen werden als JSON (Zusammenfassung, Aufgaben, Markdown, auf Wunsch das Transkript) per POST an diese Adresse übertragen. Mit Geheimnis trägt jede Anfrage die Signatur X-NotifyAI-Signature (HMAC-SHA256 über Zeitstempel und Inhalt)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finished notes are sent to this address as JSON (summary, tasks, Markdown, optionally the transcript) via POST. With a secret, every request carries the signature X-NotifyAI-Signature (HMAC-SHA256 over timestamp and content)."
          }
        }
      }
    },
    "Filter" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter"
          }
        }
      }
    },
