          "stringUnit" : {
            "state" : "translated",
            "value" : "Restoring recordings…"
          }
        }
      }
    },
    "Aufnahmen, Transkripte und Zusammenfassungen werden lokal verarbeitet und gespeichert." : {
      "localizations" : {
