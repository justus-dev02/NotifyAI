    "Mikrofon + Systemton" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone + System Audio"
          }
        }
      }
    },
    "Nimmt auf, was im Raum gesprochen wird." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records what is said in the room."
          }
        }
      }
    },
    "Nimmt nur den Ton von Apps auf, z. B. Webinare oder Videos. Das Mikrofon bleibt aus." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records only the audio of apps, e.g. webinars or videos. The microphone stays off."
          }
        }
      }
    },
    "Nur Systemton" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Audio Only"
          }
        }
      }
    },
    "PDF" : {
      "localizations" : {
