{
  "sourceLanguage" : "de",
  "strings" : {
    "1:1-Gespräch" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1:1 Conversation"
          }
        }
      }
    },
    "Achtet auf Begriffe, Definitionen, Erklärungen und alles, was prüfungsrelevant klingt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focuses on concepts, definitions, explanations and anything that sounds exam-relevant."
          }
        }
      }
    },
    "Achtet auf die Aussagen der befragten Person, ihre Bedürfnisse, Probleme und bemerkenswerte Zitate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focuses on the interviewee's statements, needs, pain points and notable quotes."
          }
        }
      }
    },
    "Achtet auf Entscheidungen, vereinbarte nächste Schritte mit Verantwortlichen und Fristen sowie offene Punkte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focuses on decisions, agreed next steps with owners and deadlines, and open issues."
          }
        }
      }
    },
    "Achtet auf Feedback, Ziele, Themen der persönlichen Entwicklung und vereinbarte Unterstützung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focuses on feedback, goals, personal development topics and agreed support."
          }
        }
      }
    },
    "Achtet auf Wünsche und Einwände des Kunden, Budget, Zeitplan und vereinbarte nächste Schritte." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focuses on the customer's needs and objections, budget, timeline and agreed next steps."
          }
        }
      }
    },
    "Alle Apps" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Apps"
