    },
    "Sammelzusammenfassung" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summary Across Notes"
          }
        }
      }
    },
    "Schnell und sparsam. Der Text erscheint live, das Sprachpaket stellt das System bereit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast and efficient. Text appears live; the system provides the language pack."
          }
        }
      }
    },
    "Sehr genau, auch bei Fachbegriffen. Benötigt ein einmal geladenes Modell; live erscheint der Text abschnittsweise." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very accurate, even with technical terms. Requires a one-time model download; live text appears in sections."
          }
        }
      }
    },
