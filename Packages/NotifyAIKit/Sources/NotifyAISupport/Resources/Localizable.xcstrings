    "Bild" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image"
          }
        }
      }
    },
    "Der Zugangsschlüssel konnte nicht im Schlüsselbund gesichert werden (Fehler %lld)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key could not be saved in the keychain (error %lld)."
          }
        }
      }
    },
    "Fasst die wichtigsten Punkte in der Reihenfolge zusammen, in der sie besprochen wurden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarizes the main points in the order they were discussed."
          }
        }
      }
    },
    "Fehlgeschlagen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed"
          }
        }
      }
    },
    "Fertig" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready"
          }
        }
      }
    },
    "Für Online-Meetings: deine Stimme über das Mikrofon, die anderen Teilnehmenden direkt aus der App (z. B. Zoom, Teams, Discord)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For online meetings: your voice through the microphone, the other participants directly from the app (e.g. Zoom, Teams, Discord)."
          }
        }
      }
    },
    "Genau und um ein Vielfaches schneller als Whisper, mit präzisen Wortzeiten. Benötigt ein einmal geladenes Modell; live erscheint der Text abschnittsweise." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accurate and many times faster than Whisper, with precise word timings. Requires a one-time model download; live text appears phrase by phrase."
          }
        }
      }
    },
