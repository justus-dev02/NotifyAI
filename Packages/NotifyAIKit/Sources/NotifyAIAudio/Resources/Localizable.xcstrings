{
  "sourceLanguage" : "de",
  "strings" : {
    "„%@“ ist nicht geöffnet. Öffne die App oder wähle „Alle Apps“ als Quelle." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is not open. Open the app or choose “All Apps” as the source."
          }
        }
      }
    },
    "Aggregate-Gerät anlegen" : {
      "localizations" : {
