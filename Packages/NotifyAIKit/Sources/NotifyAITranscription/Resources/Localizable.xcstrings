{
  "sourceLanguage" : "de",
  "strings" : {
    "%@ wird von der gewählten Spracherkennung nicht unterstützt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not supported by the selected speech recognition."
          }
        }
      }
    },
    "ca. 150 MB" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
