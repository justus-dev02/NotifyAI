{
  "sourceLanguage" : "de",
  "strings" : {
    "%@ Ohne Apple Intelligence zeige ich die passenden Stellen statt einer formulierten Antwort." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Without Apple Intelligence, I show the matching passages instead of a written answer."
          }
        }
      }
    },
    "Ähnlicher Inhalt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Similar Content"
          }
        }
      }
    },
    "Apple Intelligence konnte keine Antwort formulieren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence could not write an answer."
          }
        }
      }
    },
    "Das sind die passendsten Stellen in deinen Notizen:" : {
      "localizations" : {
