    "%@ Ohne Apple Intelligence zeige ich die passenden Stellen statt einer formulierten Antwort." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Without Apple Intelligence, I show the matching passages instead of a written answer."
          }
        }
      }
    },
    "%@ wird von der gewählten Spracherkennung nicht unterstützt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not supported by the selected speech recognition."
          }
        }
      }
    },
