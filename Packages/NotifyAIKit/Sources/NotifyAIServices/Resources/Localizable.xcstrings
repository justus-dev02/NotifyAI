    "Apple Intelligence ist derzeit nicht verfügbar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence is currently unavailable."
          }
        }
      }
    },
    "Apple Intelligence ist in den Systemeinstellungen deaktiviert." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence is turned off in System Settings."
          }
        }
      }
    },
    "Apple Intelligence konnte %lld von %lld Abschnitten nicht verarbeiten. Diese Abschnitte sind nur mit ihren wichtigsten Sätzen eingeflossen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apple Intelligence konnte %1$lld von %2$lld Abschnitten nicht verarbeiten. Diese Abschnitte sind nur mit ihren wichtigsten Sätzen eingeflossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence could not process %lld of %lld excerpts. Only their most important sentences were included."
          }
        }
      }
    },
    "Apple Intelligence konnte die Kapitel nicht zusammenführen; die Zusammenfassung wurde aus den Kapiteln zusammengestellt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence could not merge the chapters; the summary was assembled from the chapters."
          }
        }
      }
    },
    "Apple Intelligence konnte diesen Text nicht zusammenfassen." : {
      "localizations" : {
