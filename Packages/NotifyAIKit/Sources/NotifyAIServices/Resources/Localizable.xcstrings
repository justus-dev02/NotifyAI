        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %lld chapters, the notes were too long and were shortened; details may be missing there."
          }
        }
      }
    },
    "In der Aufnahme wurde keine Sprache erkannt." : {
      "localizations" : {
        "en" : {
