<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only for ad-hoc signed releases (scripts/release.sh). Same as NotifyAI-macOS.entitlements, plus: -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<!-- With the hardened runtime, macOS only loads frameworks signed by the app's own team.
	     An ad-hoc signature has no team, so Sparkle.framework would be rejected at launch.
	     Remove this file from the release script once releases are signed with a Developer ID. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
